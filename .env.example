# ===== emr-qc-recipe-runner 凭据示例 =====
# 部署时复制本文件为 .env 并填入真实值；
# 凭据一律从环境变量读取，禁止硬编码，禁止把真实生产库的 URL 写入仓库。
# 测试与本地开发可保留默认值；缺关键凭据时 load_env() 立即抛 EnvConfigError。

# — HIS / EMR 抽取（ODBC/JDBC 只读凭据） —
HIS_DB_URL=mssql+pyodbc://readonly_user:REPLACE_ME@hospital-his.internal/HISDB?driver=ODBC+Driver+17+for+SQL+Server

# — HIS 写入（人工 confirm 后落原质控台账） —
HIS_WRITE_TOKEN=REPLACE_ME_HIS_WRITE_BEARER_TOKEN
HIS_WRITE_BASE_URL=https://hospital-his.internal/api

# — 企微 webhook（命中推送，可选） —
WECOM_WEBHOOK_TOKEN=

# — 本机 SQLite 事件库（命中的不可篡改事件链） —
EVENT_DB_URL=sqlite:///data/events.db

# — ModelGateway（OpenAI-compatible 单一协议） —
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_TIMEOUT_SECONDS=30

# — Web 服务 —
PORT=8787
